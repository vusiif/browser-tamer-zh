# Generates a C++ source file that embeds translation JSON files as byte arrays.
#
# Usage (script mode):
#   cmake -DIN=<file1.json|file2.json|...> -DOUT=<output.cpp> -P embed_i18n.cmake
#
# Each file's base name (e.g. "zh_CN" for zh_CN.json) becomes its language code.

if(NOT DEFINED OUT)
    message(FATAL_ERROR "embed_i18n.cmake: OUT is not set")
endif()

if(DEFINED IN AND NOT IN STREQUAL "")
    string(REPLACE "|" ";" IN_FILES "${IN}")
else()
    set(IN_FILES "")
endif()
list(SORT IN_FILES)

set(arrays "")
set(entries "")
set(count 0)

foreach(path IN LISTS IN_FILES)
    get_filename_component(code "${path}" NAME_WE)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    if(hex_len EQUAL 0)
        message(FATAL_ERROR "embed_i18n.cmake: ${path} is empty")
    endif()
    # "e4b8ad" -> "0xe4,0xb8,0xad,"
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # keep lines short for compilers and diff tools: 32 bytes per line
    # (CMake regex has no {n} quantifier, so the pattern is spelled out)
    string(REPEAT "0x[0-9a-f][0-9a-f]," 32 line_pattern)
    string(REGEX REPLACE "(${line_pattern})" "\\1\n        " bytes "${bytes}")

    string(APPEND arrays "    const unsigned char data_${count}[] = {\n        ${bytes}\n    };\n\n")
    string(APPEND entries "        {\"${code}\", {reinterpret_cast<const char*>(data_${count}), sizeof(data_${count})}},\n")
    math(EXPR count "${count} + 1")
endforeach()

if(count EQUAL 0)
    # zero-length arrays are not valid C++; keep one empty sentinel entry
    set(entries "        {\"\", {}},\n")
endif()

set(content "// Generated by cmake/embed_i18n.cmake. Do not edit.\n\
#include <cstddef>\n\
#include <string_view>\n\
\n\
namespace bt::i18n::embedded {\n\
    struct file {\n\
        std::string_view code;\n\
        std::string_view json;\n\
    };\n\
}\n\
\n\
namespace {\n\
${arrays}}\n\
\n\
namespace bt::i18n::embedded {\n\
    extern const file files[] = {\n\
${entries}    };\n\
    extern const std::size_t files_count = ${count};\n\
}\n")

file(WRITE "${OUT}" "${content}")
